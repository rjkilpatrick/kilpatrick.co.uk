---
const links = [
  { title: "Home", url: "/" },
  { title: "Blog", url: "/post" },
  { title: "About", url: "/about" },
  { title: "CV", url: "/cv" },
  { title: "Contact", url: "/contact" },
];

const { pathname } = Astro.url;
const isActive = (url: string) =>
  url === "/" ? pathname === "/" : pathname.startsWith(url);
---

<nav class="page-navigation" role="navigation">
  <div class="nav-bar">
    <a href="/" class="brand">Kilpatrick.co.uk</a>

    <ul class="nav-links">
      {
        links.map((link) => (
          <li>
            <a href={link.url} aria-current={isActive(link.url) && "page"}>
              {link.title}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="mobile-menu">
      <summary aria-label="Main Menu">
        <span class="hamburger-icon"></span>
      </summary>
      <ul class="mobile-links">
        {
          links.map((link) => (
            <li>
              <a href={link.url} aria-current={isActive(link.url) && "page"}>
                {link.title}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</nav>

<style lang="scss">
  .page-navigation {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: var(--background-primary);
    border-bottom: 1px solid var(--background-secondary);

    @media print {
      display: none;
    }
  }

  .nav-bar {
    position: relative;
    max-width: 80ch;
    margin: 0 auto;
    padding: 1rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--text-emph);
    text-decoration: none;

    &:hover {
      color: var(--accent-1);
    }
  }

  // Desktop links
  .nav-links {
    display: none;
    list-style: none;
    align-items: center;
    gap: 1.75rem;
    margin: 0;
    padding: 0;

    a {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 1rem;
      padding-bottom: 0.2rem;
      border-bottom: 2px solid transparent;
      transition:
        color 0.2s ease,
        border-color 0.2s ease;

      &:hover {
        color: var(--text-emph);
      }

      &[aria-current="page"] {
        color: var(--text-emph);
        border-bottom-color: var(--accent-1);
      }
    }
  }

  // Mobile disclosure menu (native <details>, no JS needed)
  .mobile-menu {
    display: block;

    summary {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      list-style: none;
      cursor: pointer;

      &::-webkit-details-marker {
        display: none;
      }
    }

    .mobile-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 100;
      background-color: var(--background-secondary);
      border-bottom: 1px solid var(--background-primary);
      box-shadow: 0 8px 16px rgb(0 0 0 / 8%);
      list-style: none;
      margin: 0;
      padding: 0.5rem 1.5rem 1rem;
      display: flex;
      flex-direction: column;

      a {
        display: block;
        padding: 0.7rem 0;
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 1.1rem;

        &:hover {
          color: var(--text-emph);
        }

        &[aria-current="page"] {
          color: var(--accent-1);
        }
      }
    }
  }

  .hamburger-icon {
    position: relative;
    display: block;
    width: 22px;
    height: 2px;
    border-radius: 2px;
    background-color: var(--text-emph);
    transition: background-color 0.15s ease;

    &::before,
    &::after {
      content: "";
      position: absolute;
      left: 0;
      width: 22px;
      height: 2px;
      border-radius: 2px;
      background-color: var(--text-emph);
      transition:
        transform 0.15s ease,
        top 0.15s ease,
        opacity 0.15s ease;
    }

    &::before {
      top: -7px;
    }

    &::after {
      top: 7px;
    }
  }

  // Turn the hamburger into a close icon while the menu is open
  .mobile-menu[open] .hamburger-icon {
    background-color: transparent;

    &::before {
      top: 0;
      transform: rotate(45deg);
    }

    &::after {
      top: 0;
      transform: rotate(-45deg);
    }
  }

  @media screen and (width >= 768px) {
    .nav-links {
      display: flex;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>
