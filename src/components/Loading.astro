---
const waveItems = 24;
---

<div id="loading-overlay">
  <div class="loading-wrapper">
    {Array(waveItems).fill(<div class="wave-element" />)}
  </div>
  <p>Just loading, one second!</p>
</div>

<style lang="scss">
  #loading-overlay {
    position: fixed;
    width: 100vw;
    height: 100vh;
    inset: 0;
    z-index: 999;
    background-color: var(--background-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    &.active {
      @media (prefers-reduced-motion: no-preference) {
        animation: 500ms ease-in forwards fadeout;
      }
    }

    &.display_none {
      display: none;
    }
  }

  .loading-wrapper {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    height: 120px;
    margin: 3rem;
  }

  @keyframes fadeout {
    from {
      height: 100vh;
      opacity: 1;
    }

    to {
      height: 0;
      opacity: 0;
    }
  }

  .wave-element {
    // Positioning
    width: 0.25rem;
    height: 4rem;
    margin: 0 0.25rem;
    background: var(--text-emph);

    // Animations
    transform-origin: top center;
    animation: cosine 2000ms linear infinite;

    // Must match `waveItems` above — Sass can't read the Astro frontmatter value.
    @for $i from 1 through 24 {
      &:nth-child(#{$i}) {
        animation-delay: calc(1.5 * (-24 + ($i - 1)) * 2000ms / 24);
      }
    }
  }

  @keyframes cosine {
    0% {
      transform: rotateX(0deg);
    }

    100% {
      transform: rotateX(360deg);
    }
  }
</style>
<script is:inline>
  window.onload = async () => {
    const overlay = document.querySelector("#loading-overlay");
    if (!overlay) return;
    overlay.classList.add("active");

    // The fade-out is a CSS animation; wait for it to finish before hiding
    // the overlay outright, since `display: none` can't itself be animated.
    await new Promise((resolve) => setTimeout(resolve, 500));
    overlay.classList.add("display_none");
  };
</script>
