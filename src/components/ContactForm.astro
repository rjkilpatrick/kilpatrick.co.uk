---
const { formId } = Astro.props;
---

<div>
  <form
    action={`https://formspree.io/f/${formId}`}
    id="fs-frm"
    name="contact-form"
    accept-charset="utf-8"
    method="post"
  >
    <fieldset form="fs-frm" id="fs-frm-inputs">
      <label for="name">Name</label>
      <input type="text" name="name" id="name" placeholder="Johnny" />
      <label for="email-address" class="form-text-required">Email Address</label
      >
      <input
        type="email"
        name="email"
        id="email-address"
        placeholder="hello@example.com"
        required
        class="form-input-required"
      />
      <label for="message" class="form-text-required">Message</label>
      <textarea
        rows="5"
        name="message"
        id="message"
        placeholder="Hi John

I have an idea about..."
        required></textarea>
    </fieldset>
    <button form="fs-frm" type="submit" role="button">Submit</button>
  </form>
  <div id="form-snackbar"></div>
</div>
<style lang="scss">
  /* CSS reset */
  input,
  button,
  textarea,
  fieldset,
  label,
  #card-element:disabled {
    font-family: inherit;
    font-size: 100%;
    color: inherit;
    border: none;
    border-radius: 0;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
  }

  label,
  legend,
  ::placeholder {
    font-size: 0.825rem;
    margin-bottom: 0.5rem;
    padding-top: 0.2rem;
    display: flex;
    align-items: baseline;
  }

  /* border, padding, margin, width */
  input,
  button,
  textarea,
  #card-element {
    border: 1px solid var(--background-secondary);
    background-color: var(--background-primary);
    color: var(--text-primary);
    padding: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  input:focus,
  button:focus,
  textarea:focus {
    outline: var(--text-secondary) solid thin;
    outline-offset: -1px;
  }

  [type="text"],
  [type="email"] {
    width: 100%;
  }

  [type="button"],
  [type="submit"] {
    width: auto;
    cursor: pointer;
    appearance: auto;
  }

  [type="button"]:focus,
  [type="submit"]:focus {
    outline: none;
  }

  [type="submit"] {
    margin-bottom: 0;
  }

  select {
    text-transform: none;
  }

  /* Prevents resizing horizontally */
  textarea {
    resize: vertical;
  }

  .form-text-required {
    &::after {
      content: "*";
      color: var(--accent-1);
    }
  }

  // snackbar
  #form-snackbar {
    visibility: hidden;
    left: 50%;
    position: fixed;
    bottom: 32px;
    transform: translate(-50%, 0);
    min-width: 10rem;
    z-index: 1;
    border-radius: 2px;
    padding: 16px;
    background-color: var(--text-primary);
    color: var(--background-primary);
    text-align: center;

    .show {
      visibility: visible;

      @media (prefers-reduced-motion: no-preference) {
        animation:
          ease-out fadein 0.5s,
          ease-in fadeout 0.5s 2.5s;
      }
    }
  }

  @keyframes fadein {
    from {
      bottom: 0;
      opacity: 0;
    }

    to {
      bottom: 30px;
      opacity: 1;
    }
  }

  @keyframes fadeout {
    from {
      bottom: 30px;
      opacity: 1;
    }

    to {
      bottom: 0;
      opacity: 0;
    }
  }
</style>

<script>
  const form = document.getElementById("fs-frm") as HTMLFormElement | null;
  const snackbar = document.getElementById("form-snackbar");

  async function handleSubmit(event: SubmitEvent) {
    if (!form || !snackbar) return;

    event.preventDefault();
    snackbar.textContent = "Attempting to send form";
    snackbar.classList.add("show");
    setTimeout(() => {
      snackbar.classList.remove("show");
    }, 3000);
    const data = new FormData(form);
    form.reset();
    fetch(form.action, {
      method: form.method,
      body: data,
      headers: {
        Accept: "application/json",
      },
    })
      .then((response) => {
        if (response.ok) {
          snackbar.textContent = "Thanks for your submission!";
          form.reset();
        } else {
          response.json().then((data) => {
            if (Object.hasOwn(data, "errors")) {
              snackbar.textContent = data["errors"]
                .map((error: { message: string }) => error.message)
                .join(", ");
            } else {
              snackbar.textContent =
                "Oops! There was a problem submitting your form";
            }
          });
        }
      })
      .catch((error) => {
        snackbar.textContent = "Oops! There was a problem submitting your form";
        console.error(error);
      });
  }
  form?.addEventListener("submit", handleSubmit);
</script>
