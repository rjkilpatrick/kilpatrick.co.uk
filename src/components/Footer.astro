---
const currentYear = new Date().getFullYear();

import { Icon } from "astro-icon/components";
---

<footer class="footer">
  <h2 class="screen-reader">Footer</h2>
  <div class="footer__content">
    <p class="footer__meta">
      &copy; John Kilpatrick {currentYear} &nbsp;&middot;&nbsp;
      <a href="//github.com/rjkilpatrick/kilpatrick.co.uk" rel="external"
        >View source</a
      >
    </p>
    <nav aria-label="Social links">
      <ul class="social-icons">
        <li>
          <a
            rel="external"
            aria-label="Github"
            href="//github.com/rjkilpatrick"
          >
            <Icon name="mdi:github" class="icon" />
          </a>
        </li>
        <li>
          <a
            rel="external"
            aria-label="Linkedin"
            href="//linkedin.com/in/rjkilpatrick"
          >
            <Icon name="mdi:linkedin" class="icon" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style lang="scss">
  .footer {
    width: 100%;
    margin-top: 4rem;
    background: var(--background-secondary);

    @media print {
      display: none;
    }
  }

  .footer__content {
    max-width: 80ch;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column-reverse;
    gap: 1.25rem;
    align-items: center;
    text-align: center;

    @media screen and (width >= 600px) {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      text-align: left;
    }
  }

  .footer__meta {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin: 0;

    a {
      color: var(--text-secondary);
      text-decoration: underline;

      &:hover {
        color: var(--text-emph);
      }
    }
  }

  .social-icons {
    list-style: none;
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 0.5rem;
      background-color: var(--text-emph);
      color: var(--background-primary);
      transition: background-color 0.2s ease;

      &:hover {
        background-color: var(--accent-1);
      }
    }
  }

  .icon {
    height: 1.25rem;
    width: 1.25rem;
    display: block;
  }
</style>
