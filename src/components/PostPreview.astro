---
const { url, frontmatter } = Astro.props.post;
const { title, preview, tags, datePublished, minutesRead } = frontmatter;

import Tags from "./Tags.astro";
---

<article class="post-card">
  <div class="post-card__meta">
    <span class="post-card__date">
      {
        new Date(datePublished).toLocaleDateString("en-gb", {
          year: "numeric",
          month: "short",
          day: "numeric",
        })
      }
    </span>
    {minutesRead ? <span class="post-card__dot">&middot;</span> : null}
    {minutesRead ? <span>{minutesRead}</span> : null}
  </div>
  <h2 class="post-card__title">
    <a href={url}>{title}</a>
  </h2>
  {preview ? <p class="post-card__preview">{preview}</p> : null}
  <Tags tags={tags} />
</article>

<style lang="scss">
  .post-card {
    position: relative;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--background-secondary);

    &:first-of-type {
      padding-top: 0;
    }
  }

  .post-card__meta {
    color: var(--text-secondary);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .post-card__dot {
    margin: 0 0.4em;
  }

  .post-card__title {
    margin: 0.4rem 0 0.5rem;
    font-size: 1.5rem;

    a {
      color: var(--text-emph);
      text-decoration: none;

      // Stretched link: makes the whole card clickable while still
      // allowing the tag links below to be clicked independently.
      &::after {
        content: "";
        position: absolute;
        inset: 0;
      }

      &:hover {
        color: var(--accent-1);
      }
    }
  }

  .post-card__preview {
    margin: 0 0 0.75rem;
    color: var(--text-secondary);
  }

  :global(.post-card .post-tags) {
    position: relative;
    z-index: 1;
  }
</style>
