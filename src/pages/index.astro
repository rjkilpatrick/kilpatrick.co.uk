---
import PageLayout from "../layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { getPosts, byDateDescending } from "../lib/posts";

const posts = getPosts().sort(byDateDescending).slice(0, 3);
---

<PageLayout>
  <section class="hero">
    <div class="hero__text">
      <h1><span class="highlight">Hi,</span> I'm John 👋</h1>
      <p class="lede">
        I'm an Optical Engineer in Belfast, currently at <a href="//andor.com/"
          >Andor</a
        >. PhD Physics with interests in optics, holography, and computational
        imaging.
      </p>
      <p>
        I spend my spare time writing about science and tech on my <a
          href="/post">blog</a
        >.
      </p>
      <div class="social-row">
        <a
          class="social-icon"
          rel="external"
          aria-label="Github"
          href="//github.com/rjkilpatrick"
        >
          <Icon name="mdi:github" />
        </a>
        <a
          class="social-icon"
          rel="external"
          aria-label="Linkedin"
          href="//linkedin.com/in/rjkilpatrick"
        >
          <Icon name="mdi:linkedin" />
        </a>
      </div>
    </div>
    <div class="hero__image">
      <img
        src="/assets/img/rjkilpatrick.jpg"
        alt="Picture of John Kilpatrick"
      />
    </div>
  </section>

  <section class="posts" aria-labelledby="posts-heading">
    <h2 id="posts-heading">Recent writing</h2>
    <div class="posts__grid">
      {
        posts.map((post) => (
          <a class="post-card" href={post.url}>
            <span class="post-card__date">
              {new Date(post.frontmatter.datePublished).toLocaleDateString(
                "en-gb",
                { year: "numeric", month: "short", day: "numeric" }
              )}
            </span>
            <h3>{post.frontmatter.title}</h3>
            {post.frontmatter.preview ? (
              <p>{post.frontmatter.preview}</p>
            ) : null}
          </a>
        ))
      }
    </div>
    <a class="all-posts" href="/post">Read all posts &rarr;</a>
  </section>

  <section class="contact-cta">
    <h2>Wanna get in touch?</h2>
    <p>I'm always up for a chat about optics, side projects, or otherwise.</p>
    <a class="contact-button" href="/contact">Get in touch</a>
  </section>
</PageLayout>

<style lang="scss">
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 2rem;
    padding: 2rem 0 3rem;

    @media screen and (width >= 768px) {
      grid-template-columns: 3fr 2fr;
      gap: 3rem;
      padding: 3rem 0 4rem;
    }
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;

    h1 {
      font-size: 2.75rem;
      margin: 0;

      @media screen and (width >= 768px) {
        font-size: 3.5rem;
      }
    }

    .lede {
      font-size: 1.25rem;
      color: var(--text-primary);
    }

    p {
      margin: 0;
    }
  }

  .highlight {
    color: var(--accent-1);
  }

  .hero__image {
    order: -1;
    display: flex;
    justify-content: center;

    @media screen and (width >= 768px) {
      order: 1;
      justify-content: flex-end;
    }

    img {
      width: 60%;
      max-width: 260px;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 1rem;

      @media screen and (width >= 768px) {
        width: 100%;
      }
    }
  }

  .social-row {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .social-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    background-color: var(--text-emph);
    color: var(--background-primary);
    transition: background-color 0.2s ease;

    &:hover {
      background-color: var(--accent-1);
    }

    :global(svg) {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  section.posts,
  section.contact-cta {
    padding: 2.5rem 0;
    border-top: 1px solid var(--background-secondary);
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .posts__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;

    @media screen and (width >= 768px) {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    background-color: var(--background-secondary);
    text-decoration: none;
    color: var(--text-primary);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;

    &:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgb(0 0 0 / 12%);
    }

    h3 {
      margin: 0;
      font-size: 1.15rem;
      color: var(--text-emph);
    }

    p {
      margin: 0;
      font-size: 0.95rem;
      color: var(--text-secondary);
    }
  }

  .post-card__date {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  .all-posts {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: 1rem;
  }

  .contact-cta {
    text-align: left;

    p {
      font-size: 1.1rem;
      max-width: 60ch;
    }
  }

  .contact-button {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    background-color: var(--accent-1);
    color: white;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;

    &:hover {
      opacity: 0.85;
    }
  }
</style>
