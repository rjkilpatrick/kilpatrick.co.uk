---
import PageLayout from "../../layouts/PageLayout.astro";

import PostPreview from "../../components/PostPreview.astro";

// TODO: Export this to the tags page to stop code re-use
const postModules = import.meta.glob("./**/*.{md,mdx}", { eager: true });
const posts = Object.values(postModules).filter(
  (post) => !post.frontmatter?.draft
);

const title = "Blog";
---

<PageLayout title={title}>
  <header class="blog-header">
    <h1>Blog</h1>
    <p>Writing about optics, holography, and the odd side project.</p>
  </header>
  <section>
    {
      posts.length ? (
        posts
          // Reverse chronological order
          .sort(
            (a, b) =>
              new Date(b.frontmatter.datePublished).getTime() -
              new Date(a.frontmatter.datePublished).getTime()
          )
          .map((post) => <PostPreview post={post} />)
      ) : (
        <p>No posts here, come back later!</p>
      )
    }
  </section>
</PageLayout>

<style lang="scss">
  .blog-header {
    padding: 2rem 0 1rem;

    h1 {
      font-size: 2.75rem;
      margin: 0 0 0.5rem;
    }

    p {
      font-size: 1.15rem;
      color: var(--text-secondary);
      margin: 0;
    }

    @media screen and (min-width: 768px) {
      padding: 3rem 0 1.5rem;

      h1 {
        font-size: 3.25rem;
      }
    }
  }
</style>
