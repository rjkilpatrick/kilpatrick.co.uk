---
import PageLayout from "../../layouts/PageLayout.astro";

import PostPreview from "../../components/PostPreview.astro";
import { getPosts, byDateDescending } from "../../lib/posts";

const posts = getPosts().sort(byDateDescending);

const title = "Blog";
---

<PageLayout title={title}>
  <header class="blog-header">
    <h1>Blog</h1>
    <p>Writing about optics, holography, and the odd side project.</p>
  </header>
  <section>
    {
      posts.length ? (
        posts.map((post) => <PostPreview post={post} />)
      ) : (
        <p>No posts here, come back later!</p>
      )
    }
  </section>
</PageLayout>

<style lang="scss">
  .blog-header {
    padding: 2rem 0 1rem;

    h1 {
      font-size: 2.75rem;
      margin: 0 0 0.5rem;
    }

    p {
      font-size: 1.15rem;
      color: var(--text-secondary);
      margin: 0;
    }

    @media screen and (width >= 768px) {
      padding: 3rem 0 1.5rem;

      h1 {
        font-size: 3.25rem;
      }
    }
  }
</style>
